{
  "ir": "rezn.dev/v2",
  "deployment": "hello",
  "namespace": "hello",
  "resources": [
    {
      "kind": "replica_set",
      "name": "web",
      "fields": {
        "replicas": 1,
        "pod": {
          "containers": [
            {
              "name": "web",
              "image": "docker.io/library/nginx:1.27-alpine",
              "resources": {
                "cpu_request_millis": 2000,
                "cpu_limit_millis": 1000
              }
            }
          ]
        }
      }
    }
  ]
}
